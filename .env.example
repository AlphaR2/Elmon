# Copy to .env.local for local work. Never commit .env.local. On Vercel and Railway, set these in the dashboard.

# ---------- both the app (Vercel) and the worker (Railway) ----------
# Supabase Postgres. Vercel: the transaction pooler (port 6543). Worker: the session pooler (port 5432).
# Leave unset locally to use a throwaway in-memory database (the worker then runs inside `npm run dev`).
DATABASE_URL=

# ---------- app only (Vercel) ----------
# Supabase project URL and publishable (anon) key: used only for sign-in. Row level security keeps it out of every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of the app.
NEXT_PUBLIC_SITE_URL=
# Supabase service-role key: creates accounts at sign-up (no confirmation email) and lets admins reset passwords.
# SERVER ONLY (Vercel). Never prefix it with NEXT_PUBLIC_, never put it on the worker or in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Admins, comma separated. They get the Admin tab: invite codes, members, all runs, settings, activity.
# Everyone else joins with an invite code an admin generates. (The old email allowlist is retired.)
ELMON_ADMIN_EMAILS=
# Secret the owner types in the "invite code" box when creating an admin account for the first time. Without it
# nobody can create an account for an admin email (stops someone claiming it first). 12+ random characters.
ELMON_ADMIN_SETUP_CODE=
# Local development only: skip sign-in (refused when NODE_ENV=production).
# ELMON_DEV_NO_AUTH=1

# ---------- worker only (Railway) ----------
# The only secret that spends money. Never set it on Vercel.
HELIUS_API_KEY=
# Credits your plan gives per month (free plan: 1,000,000). Runs stop at 98%. Can be overridden in app_config.
HELIUS_MONTHLY_CREDITS=1000000
# Connections per worker (session pooler). See the sizing note in lib/db.ts.
DB_POOL_MAX=5
# Optional, recommended: Birdeye key (free plan works) for much faster runner checks. Price history then comes
# from Birdeye and GeckoTerminal together instead of GeckoTerminal alone. Get one from the Birdeye dashboard
# (Security tab; see https://data.birdeye.so/docs/quickstart). Free plan: 1 request a second, 30,000 units a month, about 2,500 token lookups.
BIRDEYE_API_KEY=
# Optional: another RPC URL (must be Helius for getTransactionsForAddress)
# HELIUS_RPC_URL=
